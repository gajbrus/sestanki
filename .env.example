# --- LLM ---------------------------------------------------------------
# anthropic | openai | fake   (fake = fixture responses, no API key needed)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Used where the provider supports it (OpenAI). Current Claude models reject sampling params.
LLM_TEMPERATURE=0
# true = LLM may polish the opening/closing sentence of the email draft (facts stay deterministic)
LLM_POLISH_EMAIL=false

# --- Internal business system (mock) --------------------------------------
CRM_BASE_URL=http://127.0.0.1:8001
CRM_TIMEOUT_SECONDS=5
# Read by mock_crm at startup: share of requests that randomly return 503 (0.0-1.0)
MOCK_CRM_FAIL_RATE=0.0

# --- Paths ---------------------------------------------------------------
DB_PATH=meeting_ai.db
TRANSCRIPTS_DIR=data/transcripts
EMPLOYEES_PATH=data/employees.json
OUTPUTS_DIR=outputs
COMPANY_NAME=Svetovanje Plus d.o.o.

# --- Review UI -------------------------------------------------------------
# Simulated login: employee id (employees.json) of the logged-in reviewer
REVIEWER_EMPLOYEE_ID=E001
